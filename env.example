# VPN Configuration (AirVPN/WireGuard)
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PRESHARED_KEY=your_preshared_key_here
WIREGUARD_ADDRESSES=your_vpn_ip_address_here

# Plex Configuration
PLEX_CLAIM=your_plex_claim_token_here

# NZBGet (optional; default in compose is 'changeme')
# NZBGET_PASS=your_nzbget_password

# Optional: Override default paths
# DOCKER_GLUETUN_PATH=/docker/gluetun
# CONTAINER_CONFIG_PATH=/container/mediastack/config
# MEDIA_LIBRARY_PATH=/mnt/nvme/mediastack/library
